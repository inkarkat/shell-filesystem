#!/bin/bash
set -o pipefail
shopt -qs extglob nullglob

${DEBUG:+eval $(debugtrace -o $- -- "$@")}

: ${FILERECALL_BASEDIR:=.}
: ${FILERECALL_OFFER_SUBDIRS=t}
: ${FILERECALL_WHAT=file}
: ${FILERECALL_WHERE=}

case "$FILERECALL_WHAT" in
    *,*)    what="${FILERECALL_WHAT%%,*}"
	    whatPlural="${FILERECALL_WHAT#*,}"
	    ;;
    *)	    what="$FILERECALL_WHAT"
	    whatPlural="${FILERECALL_WHAT}s"
	    ;;
esac
where="${FILERECALL_WHERE}${FILERECALL_WHERE:+ }"
: ${FILERECALL_COMMAND_JOINER=;}
: ${FILERECALL_EXEC_END=;}
: ${FILERECALL_FILE_MARKER='{}'}
fileMarker="$FILERECALL_FILE_MARKER"; unset FILERECALL_FILE_MARKER

getShortUsage()
{
    local -r SELECTION="$(commandOnSelected --get-short-usage selection 2>/dev/null)"
    local -r query="GREP-ARGS [...] [NAME|NAME-GLOB] [$SELECTION ...]|(NAME|NAME-GLOB|PATTERN) [$SELECTION ...]|$SELECTION ...|"""
    local usageSep
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local hadTopic=
	case "$1" in
	    ''|input)
		[ "$FILERECALL_OFFER_SUBDIRS" ] \
		    && printf %s "${usageSep}${hadTopic:+ }" '[-d|--directory SUBDIR] [-r|--recursive] [--sort=none|size|time|version|extension]' \
		    || printf %s "${usageSep}${hadTopic:+ }" '[--catalog CATALOG-FILE]'
		printf %s ' [--reverse]'
		hadTopic=t
		;;&
	    ''|query1)
		printf %s "${usageSep}${hadTopic:+ }" "[${query}]"; hadTopic=t;;&
	    ''|query2)
		printf %s "${usageSep}${hadTopic:+ }" "-c|--command \"COMMANDLINE\" [...] | --exec SIMPLECOMMAND [...]${fileMarker:+ [}${fileMarker}${fileMarker:+] [...]} ${FILERECALL_EXEC_END} [--exec ...] [${query}] [COMMAND-ARGS ...]"; hadTopic=t;;&
	    ''|query3)
		printf %s "${usageSep}${hadTopic:+ }" "${query} SIMPLECOMMAND [...]${fileMarker:+ [}${fileMarker}${fileMarker:+] [...]}"; hadTopic=t;;&
	    ''|query4)
		printf %s "${usageSep}${hadTopic:+ }" "[-c|--command \"COMMANDLINE\" [...] | --exec SIMPLECOMMAND [...]${fileMarker:+ [}${fileMarker}${fileMarker:+] [...]} ${FILERECALL_EXEC_END} [--exec ...]] [${query}] -- SIMPLECOMMAND [...]${fileMarker:+ [}${fileMarker}${fileMarker:+] [...]}"; hadTopic=t;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown short usage topic \"$1\"!" >&2; return 2; };;
	esac
	shift; usageSep=' '
    done
}
getLongUsage()
{
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local topic="$1"; shift
	local hadTopic=
	case "$topic" in
	    ''|input)
		if [ "$FILERECALL_OFFER_SUBDIRS" ]; then
		    cat <<HELPTEXT
    --directory|-d SUBDIR
			Look for ${where}${whatPlural} in the SUBDIR subdirectory.
    --recursive|-r	Also look for ${where}${whatPlural} in subdirectories.
    --sort=none|size|time|version|extension
			Sort the ${where}${whatPlural} by the given criterion.
			Default is by time (newest first).
HELPTEXT
		else
		    cat <<HELPTEXT
    --catalog CATALOG-FILE
			Look for ${where}${whatPlural} as listed in CATALOG-FILE
			(one filespec per line) instead of the current location.
HELPTEXT
		fi
		cat <<HELPTEXT
    --reverse		Reverse the order of the ${where}${whatPlural}.
HELPTEXT
		;;&
	    ''|query)
		cat <<HELPTEXT
    GREP-ARGS [...]	Recall the newest ${where}${what} whose contents
			are matched by GREP-ARGS.
    --command|-c CMD	Execute CMD as a command-line. The recalled
			${where}${what} ${fileMarker:+either }is appended${fileMarker:+ or replaces
			any $fileMarker marker} inside COMMANDLINE.
    --exec CMD [...] ${FILERECALL_EXEC_END}	Execute CMD; all following arguments are taken to be
			arguments to the CMD until an argument consisting of
			'${FILERECALL_EXEC_END}' is encountered. The recalled ${where}${what}
			${fileMarker:+either }is appended${fileMarker:+ or replaces any $fileMarker marker} inside
			COMMANDLINE.
HELPTEXT
		commandOnSelected --get-long-usage selection 2>/dev/null
		hadTopic=t
		;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown long usage topic \"$topic\"!" >&2; return 2; };;
	esac
    done
}
printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: %q %s\n' "${FILERECALL:-$(basename "$1")}" "$(getShortUsage input) [-?|-h|--help] ..."
    echo
    printf 'Usage: %q %s\n' "${FILERECALL:-$(basename "$1")}" "... $(getShortUsage query1)"
    printf 'Usage: %q %s\n' "${FILERECALL:-$(basename "$1")}" "... $(getShortUsage query2)"
    printf 'Usage: %q %s\n' "${FILERECALL:-$(basename "$1")}" "... $(getShortUsage query3)"
    printf 'Usage: %q %s\n' "${FILERECALL:-$(basename "$1")}" "... $(getShortUsage query4)"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "${FILERECALL:-$(basename "$1")}"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Recall ${what}(s) from the ${where:-current }location, or the one where the
$what name is NAME / contains *NAME-GLOB*, or the latest one where the contents
match (grep-style) PATTERN / GREP-ARGS.
The output is shown in the pager, or its filespec is ${fileMarker:+either }appended to${fileMarker:+ or
replaces any $fileMarker marker inside} COMMANDLINE (and possibly passed COMMAND-ARGS).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    getLongUsage ''
    echo
    cat <<HELPTEXT
EXIT STATUS:
    0	Complete success.
    2	Bad invocation, wrong or missing command-line arguments.
    4	No results from filtering / nothing selected.
    *	Any exit status from COMMAND(s).
HELPTEXT
}

typeset -a filespecs=()
getFiles()
{
    if [ -n "$catalogFilespec" ]; then
	if [ "$isReverse" ]; then
	    readarray -t filespecs < <(tac -- "$catalogFilespec")
	else
	    readarray -t filespecs <"$catalogFilespec"
	fi
    else
	local searchDirspec="${FILERECALL_BASEDIR}${subdir:+/$subdir}"

	while IFS=$'\n' read -r filespec
	do
	    [ -d "$filespec" ] || filespecs+=("$filespec")
	done < <(eval "ls --directory \"\${sortArg[@]}\" ${isReverse:+--reverse} \"\${searchDirspec}\"/${glob}")
    fi

    if [ ${#filespecs[@]} -eq 0 ]; then
	printf >&2 'ERROR: No %s%s in %s\n' "$where" "$whatPlural" "$searchDirspec"
	exit 2
    fi

    getFiles() { :; }
}

matchers=''
nonMatchers=''
ensureResults()
{
    [ ${#filespecs[@]} -eq 0 ] || return 0

    printf >&2 'There are no %s%s.\n' "$whatPlural" "$nonMatchers"
    return 1
}

filterByName()
{
    ${DEBUG:+eval $(debugtrace --point filterByName --var "$(declare -p filespecs)" -o $- -- "$@")}

    local literalName="$(printf %s "${subdir}${subdir:+/}${1}" | sed -e 's/[][\$*.^]/\\&/g')"
    typeset -a matchedFilespecs=()

    readarray -t matchedFilespecs < <(printf '%s\n' "${filespecs[@]}" | grep -e "\\(^\\|/\\)${literalName}\$")
    if [ ${#matchedFilespecs[@]} -gt 0 ]; then
	matchers+="${matchers:+ and} where NAME is $1"
    elif type -t -- globmatch >/dev/null; then
	readarray -t matchedFilespecs < <(globmatch --exclude-directories ${subdir:+--subpath} --files-matching "${subdir}${subdir:+/}*${1}*" "${filespecs[@]}")
	[ ${#matchedFilespecs[@]} -gt 0 ] \
	    && matchers+="${matchers:+ and} where NAME matches \"$1\""
    fi

    if [ ${#matchedFilespecs[@]} -eq 0 ]; then
	nonMatchers+="${nonMatchers:+ or} where NAME matches \"$1\""
	return 1
    fi

    filespecs=("${matchedFilespecs[@]}")
}

filterGrep()
{
    ${DEBUG:+eval $(debugtrace --point filterGrep --var "$(declare -p filespecs)" -o $- -- "$@")}

    # Note: Cannot simply use $FILERECALL_BASEDIR/* glob here because we want to
    # return a match in the newest file (and now support a catalog file).
    readarray -t filespecs < <(grep --no-messages --files-with-matches --directories=skip "$@" -- "${filespecs[@]}")
    matchers+="${matchers:+ and} where $whatPlural match $*"
    nonMatchers+="${nonMatchers:+ or} where $whatPlural match $*"
    ensureResults
}

filterSelection()
{
    ${DEBUG:+eval $(debugtrace --point filterSelection --var "$(declare -p selections filespecs)" -o $- --)}

    readarray -t filespecs < <(
	printf '%s\n' "${filespecs[@]}" \
	    | commandOnSelected --stdin \
		--entry-name "${what}${matchers//,/，},${whatPlural}${matchers//,/，}" \
		--no-entries-message "There are no ${whatPlural}${nonMatchers}." \
		"${commandOnSelectedArgs[@]}" "${selections[@]}"
    )

    [ ${#filespecs[@]} -gt 0 ]
}

typeset -a sortArg=(--sort=time)
isReverse=
catalogFilespec=
subdir=
glob='*'
commands=
typeset -a commandArgs=()
typeset -a commandOnSelectedArgs=()
typeset -a selections=()
typeset -a grepArgs=()
haveCompleteGrep=
didAttemptFilterByName=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;

	--directory|-d)	shift; [ "$FILERECALL_OFFER_SUBDIRS" ] && subdir="${1:?}"; shift;;
	--recursive|-r)	[ "$FILERECALL_OFFER_SUBDIRS" ] && glob='**'; shift;;
	--catalog)	shift; catalogFilespec="${1:?}"; shift; FILERECALL_OFFER_SUBDIRS='';;
	--sort)		sortArg=("$1" "${2?}"); shift; shift;;
	--sort=*)	sortArg=("$1"); shift;;
	--reverse)	shift; isReverse=t;;

	--command|-c)	shift; commands+="${commands:+ $FILERECALL_COMMAND_JOINER }$1"; shift;;
	--exec)		shift
			cmd=
			printf -v escapedFileMarker %q "$fileMarker"
			while [ $# -gt 0 -a "$1" != "$FILERECALL_EXEC_END" ]
			do
			    printf -v quotedArg '%q' "$1"
			    cmd+="${cmd:+ }${quotedArg//"$escapedFileMarker"/$fileMarker}"	# %q escapes {}, we don't want that to have it interpolated later.
			    shift
			done
			if [ $# -eq 0 ]; then
			    echo "ERROR: --exec command must be concluded with '${FILERECALL_EXEC_END}'"; echo; printUsage "$0"
			    exit 2
			fi >&2
			shift
			commands+="${commands:+ $FILERECALL_COMMAND_JOINER }${cmd}"
			;;

	--regexp|-e|--file|-f)
			grepArgs+=("$1" "${2?}"); shift; shift; haveCompleteGrep=t;;
	--@(regexp|file)=*)
			grepArgs+=("$1");  shift; haveCompleteGrep=t;;
	-@([EFGPivwxsaIrRUz]))
			grepArgs+=("$1"); shift;;
	--@(extended-regexp|fixed-strings|basic-regexp|perl-regexp|ignore-case|invert-match|word-regexp|line-regexp|no-messages|text|recursive|dereference-recursive|binary|null-data))
			grepArgs+=("$1"); shift;;
	-[mDd])		grepArgs+=("$1" "${2?}"); shift; shift;;
	--@(color|colour|max-count|binary-files|devices|directories|exclude|exclude-from|include)=*)
			grepArgs+=("$1"); shift;;
	--@(color|colour|max-count|binary-files|devices|directories|exclude|exclude-from|include))
			grepArgs+=("$1" "${2?}"); shift; shift;;

	--)		shift
			printf -v quotedSimpleCommand '%q ' "$@"
			printf -v escapedFileMarker %q "$fileMarker"
			commands+="${commands:+ $FILERECALL_COMMAND_JOINER }${quotedSimpleCommand//"$escapedFileMarker"/$fileMarker}"	# %q escapes {}, we don't want that to have it interpolated later.
			break
			;;
	-*)		if argCount=$(commandOnSelected --understand-for config --understands "$@"); then
			    commandOnSelectedArgs+=("${@:1:argCount}")
			    shift $argCount
			    continue
			elif [ $? -eq 2 ]; then
			    exit 2
			fi
			;;&
	*)		if [ ${#grepArgs[@]} -gt 0 ] && [ ! "$haveCompleteGrep" ]; then
			    # We have GREP-ARGS, but no PATTERN yet; this is the PATTERN.
			    grepArgs+=("$1")
			    haveCompleteGrep=t
			    shift
			elif [ -z "$1" ]; then
			    # Empty argument means matching done, following arguments are SIMPLECOMMAND or
			    # COMMAND-ARGS.
			    shift; break
			elif argCount=$(commandOnSelected --understand-for selection --understands "$@"); then
			    selections+=("${@:1:argCount}")
			    shift $argCount
			elif [ $? -eq 2 ]; then
			    exit 2
			elif [ ! "$didAttemptFilterByName" ] && didAttemptFilterByName=t \
			    && getFiles && filterByName "${1:?}"
			then
			    shift
			elif [ ${#grepArgs[@]} -eq 0 ]; then
			    grepArgs+=(-e "$1")
			    haveCompleteGrep=t
			    shift
			else
			    break
			fi
			;;
    esac
done
if [ $# -gt 0 ]; then
    case "$1" in
	--)		shift
			printf -v quotedSimpleCommand '%q ' "$@"
			printf -v escapedFileMarker %q "$fileMarker"
			commands+="${commands:+ $FILERECALL_COMMAND_JOINER }${quotedSimpleCommand//"$escapedFileMarker"/$fileMarker}"	# %q escapes {}, we don't want that to have it interpolated later.
			;;
	*)		if [ -n "$commands" ]; then
			    commandArgs+=("$@")
			else
			    printf -v quotedSimpleCommand '%q ' "$@"
			    printf -v escapedFileMarker %q "$fileMarker"
			    commands="${quotedSimpleCommand//"$escapedFileMarker"/$fileMarker}"	# %q escapes {}, we don't want that to have it interpolated later.
			fi
			;;
    esac
fi

getFiles
[ ${#grepArgs[@]} -eq 0 ] \
    || filterGrep "${grepArgs[@]}" || exit 4
filterSelection || exit 4

if [ -z "$commands" ]; then
    printf -v commands '%q %s' "${PAGER:-less}" --RAW-CONTROL-CHARS
fi
if [ ${#commandArgs[@]} -gt 0 ]; then
    printf -v quotedCommandArgs ' %q' "${commandArgs[@]}"
    commands+="$quotedCommandArgs"
fi

printf -v quotedFiles '%q ' "${filespecs[@]}"; quotedFiles="${quotedFiles% }"
interpolatedCommands="${commands//"$fileMarker"/$quotedFiles}"
[ "$interpolatedCommands" = "$commands" ] || quotedFiles=''
eval "$interpolatedCommands" "$quotedFiles"
