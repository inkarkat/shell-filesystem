#!/bin/bash

printUsage()
{
    cat <<HELPTEXT
Locate the first existing parent directory of the passed FILE|DIR. This can
be DIR itself if it exists, or the parent of FILE, or any existing directory
until eventually / is reached.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" '[--] FILE|DIR [-?|-h|--help]'
}

while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printUsage "$0"; exit 0;;
	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ $# -ne 1 ]; then
    printUsage "$0" >&2
    exit 2
fi

filespec="${1:?}"
while [ ! -d "$filespec" ]
do
    filespec="$(dirname -- "$filespec")"
done
printf '%s\n' "$filespec"
